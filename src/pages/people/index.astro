---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, plural } from '../../lib/utils';

const people = (await getCollection('people')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru'));
const recipes = await getCollection('recipes');
const count = (id: string) => recipes.filter((r) => r.data.author.id === id).length;
---

<Base title="Кто готовил">
  <h1>Кто готовил</h1>
  <p class="intro">Люди, чьи рецепты собраны в книге.</p>
  <ul class="people">
    {people.map((p) => {
      const n = count(p.id);
      return (
        <li>
          <a href={url(`people/${p.id}`)}>
            <span class="hand name">{p.data.name}</span>
          </a>
          <span class="about">
            {[p.data.relation, p.data.years, p.data.from].filter(Boolean).join(', ')}
          </span>
          <span class="count">{n} {plural(n, 'рецепт', 'рецепта', 'рецептов')}</span>
        </li>
      );
    })}
  </ul>
</Base>

<style>
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .intro { color: var(--muted); margin: 0.5rem 0 2rem; }
  .people { list-style: none; margin: 0; padding: 0; max-width: 46rem; }
  .people li {
    display: grid; grid-template-columns: 1fr auto; gap: 0 1rem; align-items: baseline;
    padding: 0.9rem 0; border-bottom: 1px solid var(--rule);
  }
  .people a { text-decoration: none; }
  .people a:hover .name { text-decoration: underline; text-decoration-thickness: 1px; }
  .name { font-size: 1.9rem; line-height: 1.1; }
  .about { grid-column: 1; color: var(--muted); font-size: 0.95rem; }
  .count { grid-column: 2; grid-row: 1; color: var(--muted); font-size: 0.95rem; white-space: nowrap; }
</style>
